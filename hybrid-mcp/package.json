{
  "name": "agentmem-hybrid-mcp",
  "version": "0.1.0",
  "description": "Hybrid retrieval MCP for AgentMemory (SQLite FTS5 + local vector + RRF). Drop-in for users who already have AgentMemory app installed.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agentmem-hybrid-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "handshake": "node scripts/handshake-test.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.5.0",
    "sqlite-vec": "^0.1.6",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codebuddy",
    "memory",
    "hybrid-search",
    "rag",
    "vector-search"
  ],
  "license": "MIT"
}
