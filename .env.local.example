# AgentMemory System - Local Configuration
# Copy this file to .env.local and fill in your values
# .env.local is ignored by git - safe to store your API keys

# =====================================
# ===== AI Provider Selection =====
# =====================================

# AI provider to use for memory processing (default: api)
#   api         - OpenAI-compatible HTTP API (requires API key below)
#   claude-code - Local claude CLI (no API key needed, requires claude CLI installed)
#                 Install: https://claude.ai/code
# CODEBUDDY_MEM_PROVIDER=api

# --- Option A: claude-code provider ---
# Uncomment the line below to use the local claude CLI instead of HTTP API:
# CODEBUDDY_MEM_PROVIDER=claude-code

# Path to the claude CLI binary (default: "claude" on PATH)
# Tencent intranet users can set:
# CODEBUDDY_MEM_CLAUDE_CODE_PATH=claude-internal
# or on Windows:
# CODEBUDDY_MEM_CLAUDE_CODE_PATH=C:\Users\your-name\AppData\Roaming\npm\claude-internal.cmd
# Only needed if claude is not on PATH or you want to pin a specific version:
# CODEBUDDY_MEM_CLAUDE_CODE_PATH=/usr/local/bin/claude

# --- Option B: HTTP API provider (default) ---

# TIMIAI API Key (Tencent Internal) - Recommended for Option B
# Get your key from: http://api.timiai.woa.com
TIMIAI_API_KEY=your_timiai_api_key_here

# Or use OpenAI API Key (Alternative)
# OPENAI_API_KEY=sk-xxx

# Or use Anthropic API Key (Alternative)
# ANTHROPIC_API_KEY=xxx

# =====================================
# ===== Model Configuration (HTTP API only) =====
# =====================================

# Custom API endpoint (default: TIMIAI endpoint)
# CODEBUDDY_MEM_API_ENDPOINT=http://api.timiai.woa.com/ai_api_manage/llmproxy/chat/completions

# Model to use (default: gpt-4o-mini)
# Recommended: gpt-4o-mini for fast processing, gpt-4o for better quality
# CODEBUDDY_MEM_MODEL=gpt-4o-mini

# =====================================
# ===== Service Configuration =====
# =====================================

# Worker HTTP Server port (default: 3847)
# CODEBUDDY_MEM_PORT=3847

# Request timeout in milliseconds (default: 60000)
# CODEBUDDY_MEM_TIMEOUT=60000

# Maximum retry attempts for AI calls (default: 3)
# CODEBUDDY_MEM_MAX_RETRIES=3

# =====================================
# ===== Log Configuration =====
# =====================================

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Log file directory (default: ./logs)
# LOG_DIR=./logs

# Maximum number of log files to keep (default: 10)
# LOG_MAX_FILES=10

# Write logs to file (default: true)
# LOG_TO_FILE=true

# Write logs to console (default: true)
# LOG_TO_CONSOLE=true

# =====================================
# ===== Data Storage =====
# =====================================

# Data storage directory (default: ~/.agent-memory)
# DATA_DIR=~/.agent-memory

# =====================================
# ===== Cross-Device Sync =====
# =====================================

# Remote agent-mem-server URL (leave empty to disable sync)
# CODEBUDDY_MEM_REMOTE_URL=https://mem.example.com:8848

# Shared token for authenticating with the remote server
# CODEBUDDY_MEM_REMOTE_TOKEN=my-secret-token

# Device name for identification (default: hostname)
# CODEBUDDY_MEM_DEVICE_NAME=mac-work

# Enable/disable sync explicitly (default: auto-detect from URL+Token)
# CODEBUDDY_MEM_SYNC_ENABLED=true

# Redact raw shell output and file diffs before syncing (default: false)
# CODEBUDDY_MEM_SYNC_REDACT_RAW=false
