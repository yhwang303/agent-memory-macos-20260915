; installer.nsh — NSIS hooks for AgentMemory (AgentMemory) installer
; -----------------------------------------------------------------------------
; 目标:
;   1. 安装时:在 ${INSTDIR}\bin\ 下生成 agentmem-hybrid-mcp.cmd /
;      agentmem-resume-mcp.cmd 包装脚本,并把 ${INSTDIR}\bin 加入当前用户的
;      Path,使 IDE 的 mcp.json 直接写
;        "command": "agentmem-hybrid-mcp"  /  "command": "agentmem-resume-mcp"
;      即可工作
;   2. 卸载时:撤回上面两步,不污染其他 PATH 项
;   3. 兼容:升级安装时清理 2.1.0-beta.5 及更早 beta 留下的旧 cbm-* wrapper
;
; 设计要点:
;   - 修改 HKEY_CURRENT_USER\Environment,无需管理员权限
;   - PATH 操作用 PowerShell **脚本文件 (-File)** 而非内联 -Command,避免
;     NSIS / cmd / PowerShell 三层引号嵌套时的转义陷阱(2.1.0-beta.5 之前
;     用 -Command 模式,在某些用户机器上静默失败导致 .cmd 文件已生成但
;     PATH 没注册,IDE 的 mcp.json 无法解析命令名)。
;   - 重复安装幂等:PowerShell 内部检查段是否已存在
;   - 卸载时精确剥离我们写入的那一段,且通过 SetEnvironmentVariable 自动
;     广播 WM_SETTINGCHANGE 让新启动的 IDE 立即看到
;
; 执行入口: nsExec::ExecToLog (不弹窗、写日志,适合后台执行)
; -----------------------------------------------------------------------------

!macro WriteRegisterPathScript
  ; 在 $PLUGINSDIR 下生成 register-path.ps1
  ; PowerShell 变量用 $$,NSIS 变量直接写。所有字符串用单引号避免 PS 插值。
  FileOpen $0 "$PLUGINSDIR\agentmemory-register-path.ps1" w
  FileWrite $0 "param([Parameter(Mandatory=$$true)][string]$$Bin)$\r$\n"
  FileWrite $0 "$$ErrorActionPreference = 'Stop'$\r$\n"
  FileWrite $0 "$$p = [Environment]::GetEnvironmentVariable('Path','User')$\r$\n"
  FileWrite $0 "if ($$null -eq $$p) { $$p = '' }$\r$\n"
  FileWrite $0 "$$segs = $$p.Split(';') | Where-Object { $$_ }$\r$\n"
  FileWrite $0 "if ($$segs -notcontains $$Bin) {$\r$\n"
  FileWrite $0 "  $$np = if ($$p) { $$p.TrimEnd(';') + ';' + $$Bin } else { $$Bin }$\r$\n"
  FileWrite $0 "  [Environment]::SetEnvironmentVariable('Path', $$np, 'User')$\r$\n"
  FileWrite $0 "  Write-Host ('AgentMemory: PATH +' + $$Bin)$\r$\n"
  FileWrite $0 "} else { Write-Host ('AgentMemory: PATH already has ' + $$Bin) }$\r$\n"
  FileClose $0
!macroend

!macro WriteUnregisterPathScript
  FileOpen $0 "$PLUGINSDIR\agentmemory-unregister-path.ps1" w
  FileWrite $0 "param([Parameter(Mandatory=$$true)][string]$$Bin)$\r$\n"
  FileWrite $0 "$$ErrorActionPreference = 'Stop'$\r$\n"
  FileWrite $0 "$$p = [Environment]::GetEnvironmentVariable('Path','User')$\r$\n"
  FileWrite $0 "if ($$p) {$\r$\n"
  FileWrite $0 "  $$arr = $$p.Split(';') | Where-Object { $$_ -and ($$_ -ne $$Bin) }$\r$\n"
  FileWrite $0 "  $$np = [string]::Join(';', $$arr)$\r$\n"
  FileWrite $0 "  [Environment]::SetEnvironmentVariable('Path', $$np, 'User')$\r$\n"
  FileWrite $0 "  Write-Host ('AgentMemory: PATH -' + $$Bin)$\r$\n"
  FileWrite $0 "}$\r$\n"
  FileClose $0
!macroend

!macro customInstall
  ; ── 0. 升级兼容: 清理 2.1.0-beta.5 之前留下的 cbm-* / 2.1.0-beta.7 之前留下的
  ;        agentmem-resume-mcp.cmd (resume MCP 已移除) / 兼容自身重装 ───────
  Delete "$INSTDIR\bin\cbm-hybrid-mcp.cmd"
  Delete "$INSTDIR\bin\cbm-resume-mcp.cmd"
  Delete "$INSTDIR\bin\agentmem-resume-mcp.cmd"

  ; ── 1. 在 INSTDIR\bin\ 生成 agentmem-hybrid-mcp.cmd ───────────────────
  CreateDirectory "$INSTDIR\bin"
  FileOpen $0 "$INSTDIR\bin\agentmem-hybrid-mcp.cmd" w
  FileWrite $0 "@echo off$\r$\n"
  FileWrite $0 "rem agentmem-hybrid-mcp launcher (generated by AgentMemory installer)$\r$\n"
  FileWrite $0 "rem do not edit; will be overwritten on upgrade$\r$\n"
  FileWrite $0 '"$INSTDIR\resources\node.exe" "$INSTDIR\resources\hybrid-mcp\dist\server.js" %*$\r$\n'
  FileClose $0

  ; ── 2. 把 $INSTDIR\bin 加入当前用户 Path ─────────────────────────────
  ;       通过预先写好的 PS1 + -File 调用,避开内联 -Command 的引号陷阱。
  !insertmacro WriteRegisterPathScript
  nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PLUGINSDIR\agentmemory-register-path.ps1" "$INSTDIR\bin"'
  Pop $0
  DetailPrint "[AgentMemory] PATH register exit code: $0"
!macroend

!macro customUnInstall
  ; ── 1. 删 agentmem-*.cmd 以及历史遗留的 cbm-*.cmd 与 bin 目录 ─────────
  Delete "$INSTDIR\bin\agentmem-hybrid-mcp.cmd"
  Delete "$INSTDIR\bin\agentmem-resume-mcp.cmd"
  Delete "$INSTDIR\bin\cbm-hybrid-mcp.cmd"
  Delete "$INSTDIR\bin\cbm-resume-mcp.cmd"
  RMDir "$INSTDIR\bin"

  ; ── 2. 从用户 Path 中移除 $INSTDIR\bin ─────────────────────────────────
  !insertmacro WriteUnregisterPathScript
  nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PLUGINSDIR\agentmemory-unregister-path.ps1" "$INSTDIR\bin"'
  Pop $0
  DetailPrint "[AgentMemory] PATH unregister exit code: $0"
!macroend
